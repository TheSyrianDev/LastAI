#!/bin/bash
# Wire the Omarchy extras of the Last AI package for the current user (no root).
#   lastai-omarchy-setup             set up or update (safe to run again)
#   lastai-omarchy-setup --uninstall remove what this command set up
#   lastai-omarchy-setup --dry-run   show what would happen, change nothing
# It never edits your Hyprland config; it prints the one window rule for you to add.
set -euo pipefail

share="${LASTAI_SHARE:-/usr/share/lastai/omarchy}"
data="${XDG_DATA_HOME:-$HOME/.local/share}"
hook_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/hooks/theme-set.d"
hook="$hook_dir/lastai-icon"

dry=0; mode=install
for a in "$@"; do
  case "$a" in
    --uninstall) mode=uninstall ;;
    --dry-run) dry=1 ;;
    -h|--help) sed -n '2,6p' "$0"; exit 0 ;;
    *) echo "unknown option: $a" >&2; exit 2 ;;
  esac
done
(( EUID != 0 )) || { echo "run this as your own user, not root" >&2; exit 1; }

run() { if (( dry )); then echo "would run: $*"; else "$@"; fi; }

if [[ $mode == uninstall ]]; then
  [[ -e $hook ]] && run rm -f "$hook"
  for f in "$data"/icons/hicolor/*/apps/lastai.{svg,png}; do
    [[ -e $f ]] && run rm -f "$f"
  done
  echo "Omarchy extras removed for $USER. The package itself stays; remove it with: sudo pacman -R lastai"
  echo "If you added the Hyprland window rule for lastai-gui, you can remove it yourself."
  exit 0
fi

for f in theme-set-hook lastai-icon-refresh; do
  [[ -f $share/$f ]] || { echo "missing $share/$f; is the lastai package installed?" >&2; exit 1; }
done

# the hook runs the packaged icon refresh instead of one in ~/.local/bin
tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
sed "s|\${LASTAI_BIN:-\$HOME/.local/bin}|\${LASTAI_BIN:-$share}|" "$share/theme-set-hook" > "$tmp"
run install -Dm755 "$tmp" "$hook"

if command -v rsvg-convert >/dev/null; then
  run "$share/lastai-icon-refresh" || echo "icon refresh failed; it runs again on the next theme change" >&2
else
  echo "rsvg-convert not found; install librsvg for a theme-coloured icon" >&2
fi

cat <<'MSG'

Last AI is set up for Omarchy. For the see-through "Omarchy (transparent)" look, add this line to your
Hyprland config yourself (this command does not touch it):

  o.window("lastai-gui", { opacity = "0.85 override 0.85 override" })
MSG
